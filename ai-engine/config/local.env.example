# Rental AI engine 配置（单一来源）。
# Copy to local.env：
# Windows: copy config\local.env.example config\local.env

DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
AI_ENGINE_API_KEY=change-me

APP_NAME=rental-ai-engine
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=9000
DEBUG=false

LLM_MODEL=qwen-turbo
LLM_TEMPERATURE=0.7

EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3
EMBEDDING_BATCH_SIZE=16
EMBEDDING_CACHE_MAX_SIZE=1000

OCR_MODEL=qwen-vl-ocr-latest
OCR_TIMEOUT_SECONDS=30
OCR_MAX_RETRIES=3
RAG_ENABLED=true
MEMORY_ENABLED=true
OCR_ENABLED=false

# Docker 与 deploy/mysql 同属 rental_ai_net 时：主机名必须为 mysql（不是 127.0.0.1）
DB_HOST=mysql
DB_PORT=3306
DB_NAME=rent_db
DB_USER=rent_user
DB_PASSWORD=rent_pass

# 可选代理
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
