# 复制为 deploy/.env（在 deploy 目录执行 compose 时会自动加载）
# copy .env.example .env

# ---------- 与 ai-engine 分两个 compose 启动时 ----------
# deploy 与 ai-engine 的 compose 均使用固定网络名 rental_ai_net，无需手动 docker network create。
# 建议先起 MySQL：在 deploy 目录 docker compose up -d mysql
# 再在 ai-engine 目录 docker compose up -d（引擎需连 mysql）
# 最后 deploy 目录 docker compose up -d backend
#
# 后端在 Docker 容器内时必须用服务名（不要用 127.0.0.1，否则会连到后端容器自身）：
AI_ENGINE_BASE_URL=http://ai-engine:9000
# 必须与 ai-engine 侧 AI_ENGINE_API_KEY 一致（可在 ai-engine 目录放同名 .env 供 compose 替换）
AI_ENGINE_API_KEY=change-me

# ---------- 不配共用网络时的备选 ----------
# 引擎单独映射宿主机 9000 端口时，后端容器可用（Docker Desktop Win/Mac 常见）：
# AI_ENGINE_BASE_URL=http://host.docker.internal:9000
# 此时 ai-engine 的 DB_HOST 不能写 mysql，需改为 host.docker.internal 且 DB_PORT=3307（见 ai-engine compose 注释）

# 可选
# AI_ENGINE_TIMEOUT_SECONDS=30

# 邮箱验证码（不用可保持 SMTP 为空）
# SMTP_SERVER=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_USE_SSL=true
# SMTP_USE_TLS=false
